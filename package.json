{
  "name": "videoexplain-skill",
  "version": "0.4.0",
  "description": "Create original narrated explainer videos from research papers and concepts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunghoojung/videoexplain-skill.git"
  },
  "type": "module",
  "bin": {
    "explain-concept": "skills/explain-concept/scripts/explain-concept.mjs"
  },
  "files": [
    "skills/explain-concept/SKILL.md",
    "skills/explain-concept/LICENSE",
    "skills/explain-concept/agents/*.yaml",
    "skills/explain-concept/references/*.md",
    "skills/explain-concept/scripts/*.mjs",
    "skills/explain-concept/scripts/*.py",
    "README.md",
    "LICENSE",
    "skills/explain-concept/assets/*.json",
    "skills/explain-concept/requirements.txt",
    "skills/explain-concept/assets/*.jsx"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  }
}
